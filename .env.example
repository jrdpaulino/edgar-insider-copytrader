# Copy to .env and fill in. Never commit .env.

# The SEC requires automated clients to identify themselves. Use your real name and email.
SEC_USER_AGENT=Jane Doe jane@example.com

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Safety switches (defaults shown). Start here.
PAPER=true
DRY_RUN=true
# Only needed for real-money trading (PAPER=false and DRY_RUN=false):
# CONFIRM_LIVE_TRADING=I_UNDERSTAND_THE_RISKS

# Sizing and limits
MAX_ORDER_USD=250
MAX_DAILY_USD=1000
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=20
MAX_NEW_PER_RUN=5

# Signal: cluster of insider open-market buys
WINDOW_DAYS=14
MAX_TX_AGE_DAYS=10
MIN_INSIDERS=2
MIN_TOTAL_USD=50000
SINGLE_BUY_USD=250000
MIN_PRICE=3
MAX_PREMIUM_PCT=0.10
HOLD_DAYS=90
# TICKER_BLOCKLIST=GME,AMC

# EDGAR collection
FILING_LOOKBACK_DAYS=14
REQUEST_DELAY=0.15
